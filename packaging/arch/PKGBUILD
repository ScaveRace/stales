# Maintainer: Fynn Herr
#
# Builds the latest Stales from git. To install locally:
#   cd packaging/arch && makepkg -si
pkgname=stales-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, keyboard-driven web browser with an Arc-style sidebar"
arch=('x86_64' 'aarch64')
url="REPO_URL"
license=('GPL-3.0-or-later')
depends=('gtk4' 'webkitgtk-6.0' 'glib2' 'libsoup3')
makedepends=('cargo' 'git')
provides=('stales')
conflicts=('stales')
source=("stales::git+REPO_URL.git")
sha256sums=('SKIP')
options=('!lto')

pkgver() {
  cd stales
  printf "%s.r%s.g%s" "$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd stales
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd stales
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd stales
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd stales
  install -Dm755 target/release/stales "$pkgdir/usr/bin/stales"
  install -Dm644 data/dev.stales.Stales.desktop "$pkgdir/usr/share/applications/dev.stales.Stales.desktop"
  install -Dm644 data/icons/dev.stales.Stales.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.stales.Stales.svg"
  install -Dm644 data/dev.stales.Stales.metainfo.xml "$pkgdir/usr/share/metainfo/dev.stales.Stales.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
