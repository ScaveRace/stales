[Desktop Entry]
Type=Application
Name=Stales
GenericName=Web Browser
Comment=Fast, keyboard-driven web browser with an Arc-style sidebar
Exec=stales %U
Icon=dev.stales.Stales
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;browser;internet;arc;
StartupNotify=true
StartupWMClass=dev.stales.Stales
Actions=new-window;

[Desktop Action new-window]
Name=New Tab
Exec=stales stales://welcome
